# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - never commit real credentials
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing
/tests/e2e/.auth/
/supabase/.temp/
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# editors
.idea/
.vscode/*
!.vscode/extensions.json

# Windows reserved device name. A stray file called `nul` can be created by a
# redirect and cannot be deleted through normal APIs, but it must never be
# committed — git aborts the whole `add` when it tries to index it.
/nul

# Local agent tooling: project notes, plans and editor config.
# Kept on disk, not published. AGENTS.md is rewritten by `next dev` on every
# run, so it has to be ignored rather than merely deleted.
.claude/
/CLAUDE.md
/AGENTS.md
