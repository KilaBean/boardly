# ---------------------------------------------------------------------------
# Boardly environment configuration
#
# Copy to .env.local and fill in real values:
#     cp .env.example .env.local
#
# .env.local is gitignored. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# PUBLIC — inlined into the browser bundle.
# Anything here is readable by any visitor. Only put non-secret values here.
# ---------------------------------------------------------------------------

# Supabase project URL (Dashboard > Project Settings > Data API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anonymous/publishable key. Safe to expose ONLY because Row Level
# Security is enforced on every table. RLS is what makes this key safe.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Liveblocks public key (Dashboard > API keys). Used by the browser client.
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY="pk_dev_your-liveblocks-public-key"

# Canonical application URL. Used for OAuth redirects and invitation links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# SERVER-ONLY — must never reach the browser.
# These are validated in src/lib/env/server.ts, which imports "server-only"
# so that any client component importing them fails the build.
# ---------------------------------------------------------------------------

# Supabase service-role key. BYPASSES Row Level Security entirely.
# Use only in trusted server code, never in a client component or route that
# echoes it back. Treat as equivalent to full database access.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Liveblocks secret key. Used exclusively by the server-side room
# authorization endpoint, which derives room access from Postgres membership.
LIVEBLOCKS_SECRET_KEY="sk_dev_your-liveblocks-secret-key"

# ---------------------------------------------------------------------------
# GOOGLE OAUTH — only needed to offer "Continue with Google".
#
# These are read by the Supabase CLI (supabase/config.toml), not by Next.js, so
# they must be exported into the shell before `supabase start`:
#
#   export SUPABASE_AUTH_GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
#   export SUPABASE_AUTH_GOOGLE_SECRET="..."
#
# For a hosted project these are entered in the Supabase dashboard instead.
# ---------------------------------------------------------------------------
SUPABASE_AUTH_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
SUPABASE_AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
